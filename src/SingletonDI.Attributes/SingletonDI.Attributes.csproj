<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SingletonDI.Attributes</RootNamespace>
    <AssemblyName>SingletonDI.Attributes</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SingletonDI</PackageId>
    <Title>SingletonDI</Title>
    <Copyright>Copyright (c) 2026 Denis Tulupov</Copyright>
    <Authors>Denis Tulupov</Authors>
    <PackageProjectUrl>https://github.com/viruseg/SingletonDI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/viruseg/SingletonDI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>SingletonDI is a library for declarative management of singleton dependencies in .NET.</Description>
    <PackageReleaseNotes>
      1.0.0: First version
    </PackageReleaseNotes>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3</AssemblyVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IncludeContentInPack>true</IncludeContentInPack>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DocumentationFile>bin\Release\$(TargetFramework)\SingletonDI.Attributes.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SingletonDI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Заставляем проекты генератора и рефакторинга собраться ДО того, как начнет паковаться этот пакет -->
  <ItemGroup>
    <ProjectReference Include="..\SingletonDI.Generator\SingletonDI.Generator.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SingletonDI.Refactoring\SingletonDI.Refactoring.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Подтягиваем файлы генератора и анализатора прямо в папку analyzers -->
  <ItemGroup>
    <None Include="..\SingletonDI.Generator\bin\$(Configuration)\netstandard2.0\SingletonDI.Generator.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />

    <None Include="..\SingletonDI.Refactoring\bin\$(Configuration)\netstandard2.0\SingletonDI.Refactoring.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
