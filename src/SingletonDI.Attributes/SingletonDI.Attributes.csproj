<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SingletonDI.Attributes</RootNamespace>
    <AssemblyName>SingletonDI.Attributes</AssemblyName>
    <IsPackable>true</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageId>SingletonDI</PackageId>
    <Title>SingletonDI</Title>
    <Copyright>Copyright (c) 2026 Denis Tulupov</Copyright>
    <Authors>Denis Tulupov</Authors>
    <PackageProjectUrl>https://github.com/viruseg/SingletonDI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/viruseg/SingletonDI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>SingletonDI is a library for declarative management of singleton dependencies in .NET.</Description>
    <PackageReleaseNotes>
      1.2.1: Code fixes no longer reformat the surrounding code; a fix changes only the text it is responsible for.
      1.2.0: SingletonDIStartupData for passing external values to providers during initialization, and one initialization per process.
      1.1.0: Roslyn 4.8 compatibility, deterministic packaging, and runtime lifecycle hardening.
      1.0.0: First version
    </PackageReleaseNotes>
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1</AssemblyVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DocumentationFile>bin\Release\$(TargetFramework)\SingletonDI.Attributes.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SingletonDI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Заставляем проекты генератора и рефакторинга собраться ДО того, как начнет паковаться этот пакет -->
  <ItemGroup>
    <ProjectReference Include="..\SingletonDI.Generator\SingletonDI.Generator.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SingletonDI.Refactoring\SingletonDI.Refactoring.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="PackAnalyzerAssemblies" BeforeTargets="_GetPackageFiles">
    <MSBuild
      Projects="@(ProjectReference->'%(FullPath)')"
      Targets="GetTargetPath"
      Properties="TargetFramework=netstandard2.0;Configuration=$(Configuration)"
      BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="AnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(AnalyzerAssembly)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
